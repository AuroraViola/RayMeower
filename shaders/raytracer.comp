#version 460

#extension GL_EXT_scalar_block_layout: enable
#extension GL_EXT_nonuniform_qualifier: enable

#define PI 3.14159265

layout(scalar) struct Ray {
    vec3 origin;
    vec3 direction;
};

layout(scalar) struct AABB {
    vec3 min;
    vec3 max;
};

layout(scalar) struct HitPoint {
    bool hit;
    vec3 point;
    vec3 normal;
    vec3 barycentric;
    float distance;
};

layout(scalar) struct Triangle {
    mat3 vertices;
    mat3 normals;
    mat3x2 uv;
    int materialIndex;
};

layout(scalar) struct BvhNode {
    int left;
    int right;
    Triangle triangle;
    AABB aabb;
};

layout(scalar) struct Sun {
    vec3 dir;
    vec3 color;
    float intensity;
    float angle;
};

layout(scalar) struct Material {
    vec3 color;
    float metallic;
    float roughness;
    float transmissive;
    vec3 emissionColor;
    float emissionIntensity;
    float ior;
    int texture;
    int roughnessMap;
    int normalMap;
    int enableTexture;
    int enableRoughnessMap;
    int enableNormalMap;
};

layout(scalar, set=0, binding=1) buffer Bvh {
    BvhNode node[];
} bvh;

layout(scalar, set=0, binding=2) buffer M {
    Material material[];
} material;

layout(set=0, binding=3) uniform texture2D textures[1024];

layout(set=0, binding=4) uniform sampler samplers[2];

HitPoint TriangleIntersection(Ray ray, Triangle triangle) {
    HitPoint hit;
    hit.hit = false;
    hit.barycentric = vec3(0, 0, 0);

    float epsilon = 1e-5;

    vec3 edge1 = triangle.vertices[1] - triangle.vertices[0];
    vec3 edge2 = triangle.vertices[2] - triangle.vertices[0];

    // Backface culling, assuming CCW-wound triangles.
    const vec3 normal = -cross(edge1, edge2); // No need to normalize

    vec3 ray_cross_e2 = cross(ray.direction, edge2);
    float det = dot(edge1, ray_cross_e2);

    if (abs(det) < epsilon)
        return hit; // Ray is parallel to triangle

    float inv_det = 1.0 / det;
    vec3 s = ray.origin - triangle.vertices[0];
    float u = inv_det * dot(s, ray_cross_e2);

    if (u < -epsilon || u - 1 > epsilon)
        return hit; // Ray passes outside edge2's bounds

    vec3 s_cross_e1 = cross(s, edge1);
    float v = inv_det * dot(ray.direction, s_cross_e1);

    if (v < -epsilon || u + v - 1 > epsilon)
        return hit; // Ray passes outside edge1's bounds

    // The ray line intersects with the triangle.
    // We compute t to find where on the ray the intersection is.
    float t = inv_det * dot(edge2, s_cross_e1);

    if (t > epsilon) // Ray intersection
    {
        hit.point = ray.origin + (ray.direction * t);
        hit.hit = true;
        hit.normal = -normalize(normal);
        hit.distance = t;
        hit.barycentric = vec3(1 - u - v, u, v);
        return hit;
    }
    // This means that there is a line intersection but not a ray intersection.
    return hit;
}

bool IntersectionAABB(Ray ray, AABB aabb) {
    vec3 vtmin = (aabb.min - ray.origin) / ray.direction;
    vec3 vtmax = (aabb.max - ray.origin) / ray.direction;

    vec3 tmin = min(vtmin, vtmax);
    vec3 tmax = max(vtmin, vtmax);

    float enter = max(tmin.x, max(tmin.y, tmin.z));
    float exit = min(tmax.x, min(tmax.y, tmax.z));

    return exit > 0.0 && exit > enter;
}

#define STACK_SIZE 32
    int stacks[STACK_SIZE];

#define stack_init() \
    uint stack_p = 0

#define stack_push(v) \
    stacks[stack_p++] = v

#define stack_pop() \
    (stacks[--stack_p])

#define stack_len() \
    (stack_p)

HitPoint BVHHit(Ray ray, out Triangle t, out int node) {
    HitPoint hit;
    hit.hit = false;
    hit.barycentric = vec3(0);
    stack_init();

    // push root to stack
    stack_push(0);

    while (stack_len() > 0 && stack_len() < STACK_SIZE) {
        int currentNode = stack_pop();
        if (bvh.node[currentNode].left == -1 && bvh.node[currentNode].right == -1) {
            HitPoint currentHit = TriangleIntersection(ray, bvh.node[currentNode].triangle);
            if (hit.hit == false || hit.distance > currentHit.distance) {
                hit = currentHit;
                t = bvh.node[currentNode].triangle;
                node = currentNode;
            }
        }
        else {
            bool intersect = IntersectionAABB(ray, bvh.node[currentNode].aabb);
            if (intersect) {
                if (bvh.node[currentNode].left != -1) {
                    stack_push(bvh.node[currentNode].left);
                }
                if (bvh.node[currentNode].right != -1) {
                    stack_push(bvh.node[currentNode].right);
                }
            }
        }
    }
    return hit;
}

vec3 seed;

float hash12(vec2 p) {
    vec3 p3  = fract(vec3(p.xyx) * .1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p3) {
    p3  = fract(p3 * .1031);
    p3 += dot(p3, p3.zyx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float rand() {
    seed.x += 1.3;
    seed.y += 1.7;
    return hash13(seed);
}

layout(local_size_x=8, local_size_y=8, local_size_z=1) in;

layout(scalar, set=0, binding=0) buffer O {
    vec3 a[];
} o;

layout(push_constant, scalar) uniform Pc{
    int width;
    int height;
    vec3 cameraPos;
    mat3 rotmat;
    uint time;
    int depth;
    Sun sun;
    vec3 skyColor;
} pc;

mat3 Tbn(vec3 n) {
    vec3 u;
    if(abs(n.z) > 0.0) {
        u = vec3(0.0, -n.z, n.y)/ length(vec3(n.y, n.z, 0.0));
    }
    else {
        u = vec3(n.y, -n.x, 0.0)/ length(vec3(n.x, n.y, 0.0));
    }

    mat3 TBN;
    TBN[0] = u;
    TBN[1] = cross(n, u);
    TBN[2] = n;

    return TBN;
}

vec2 UniformRandomCirclePoint(float radius, vec2 u) {
    float alpha = u.x * 2 * PI;
    radius = sqrt(u.y) * radius;
    return vec2(radius * sin(alpha), radius * cos(alpha));
}

vec3 cosWeightedRandomHemisphereDirection(vec3 n) {
    vec2 rv2;
    rv2.x = rand();
    rv2.y = rand();

    vec3 uu = normalize(cross(n, vec3(0.0, 1.0, 1.0)));
    vec3 vv = normalize(cross(uu, n));

    float ra = sqrt(rv2.y);
    float rx = ra * cos(6.2831 * rv2.x);
    float ry = ra * sin(6.2831 * rv2.x);
    float rz = sqrt(1.0 - rv2.y);
    vec3 rr = uu * rx + vv * ry + n * rz;

    return normalize(rr);
}

vec3 InterpolateAttribute(HitPoint hit, mat3 v) {
    v[0] = v[0] * hit.barycentric.x;
    v[1] = v[1] * hit.barycentric.y;
    v[2] = v[2] * hit.barycentric.z;
    return v[0] + v[1] +v[2];
}

vec3 sampleGgxVndf(vec3 ve, vec2 alpha, vec2 U) {
    vec3 Vh = normalize(vec3(alpha.x * ve.x, alpha.y * ve.y, ve.z));
    float lensq = length(vec3(Vh.x, Vh.y, 0));

    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * (1/sqrt(lensq)) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);

    float r = sqrt(U.x);
    float phi = 2.0 * PI * U.y;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(1.0 - t1 * t1) + s * t2;

    vec3 Nh = T1 * t1 + T2 * t2 + Vh * sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2));

    vec3 Ne = normalize(vec3(alpha.x * Nh.x, alpha.y * Nh.y, max(0.0, Nh.z)));
    return Ne;
}

vec3 Reflect(vec3 v, vec3 n) {
    return v - n * 2*dot(n, v);
}

vec3 Refract(vec3 direction, vec3 normal, float ior) {
    direction = -direction;
    float cosTheta = -dot(direction, normal);
    normal = -normal;
    if (cosTheta < 0) {
        normal = -normal;
        cosTheta = -cosTheta;
        ior = 1/ior;
    }
    float sin2ThetaI = 1 - cosTheta * cosTheta;
    float sin2ThetaT = sin2ThetaI / (ior * ior);
    if (sin2ThetaT >= 1) {
        // Total internal reflection handled in Fresnel
        sin2ThetaT = 1;
    }
    float cosThetaT = sqrt(1 - sin2ThetaT);
    return normalize((direction / -ior) + (normal * (cosTheta / ior - cosThetaT)));
}

float FresnelDielectric(float cosTheta, float ior) {
    if (cosTheta < 0) {
        cosTheta = -cosTheta;
        ior = 1/ior;
    }
    float sin2ThetaI = 1 - cosTheta * cosTheta;
    float sin2ThetaT = sin2ThetaI / (ior * ior);
    if (sin2ThetaT >= 1) {
        return 1.0f;
    }
    float cosThetaT = sqrt(1 - sin2ThetaT);

    float rParl = (ior * cosTheta - cosThetaT) /
    (ior * cosTheta + cosThetaT);
    float rPerp = (cosTheta - ior * cosThetaT) /
    (cosTheta + ior * cosThetaT);
    return ((rParl * rParl) + (rPerp * rPerp)) / 2;
}

mat3 TbnUv(vec3 n, Triangle t) {
    vec3 edge1 = t.vertices[1] - t.vertices[0];
    vec3 edge2 = t.vertices[2] - t.vertices[0];
    vec2 deltaUv1 = t.uv[1] - t.uv[0];
    vec2 deltaUv2 = t.uv[2] - t.uv[0];


    float f = 1.0f / (deltaUv1.x * deltaUv2.y - deltaUv2.x * deltaUv1.y);

    vec3 tangent;
    vec3 bitangent;

    tangent.x = f * (deltaUv2.y * edge1.x - deltaUv1.y * edge2.x);
    tangent.y = f * (deltaUv2.y * edge1.y - deltaUv1.y * edge2.y);
    tangent.z = f * (deltaUv2.y * edge1.z - deltaUv1.y * edge2.z);

    bitangent.x = f * (-deltaUv2.x * edge1.x + deltaUv1.x * edge2.x);
    bitangent.y = f * (-deltaUv2.x * edge1.y + deltaUv1.x * edge2.y);
    bitangent.z = f * (-deltaUv2.x * edge1.z + deltaUv1.x * edge2.z);

    mat3 TBN;

    TBN[0] = normalize(tangent);
    TBN[1] = normalize(bitangent);
    TBN[2] = n;

    return TBN;
}

vec3 Shade(Ray r, int depth) {
    vec3 color = vec3(0.0);
    vec3 materialColor = vec3(1.0);

    for (int i = 0; i < depth; i++) {
        Triangle t;
        int triangleId;
        HitPoint hit = BVHHit(r, t, triangleId);

        if (hit.hit) {
            hit.normal = -InterpolateAttribute(hit, t.normals);
            float roughness = material.material[t.materialIndex].roughness;
            vec3 hitColor = material.material[t.materialIndex].color;

            // Apply diffuse texture
            if (material.material[t.materialIndex].texture != -1 && material.material[t.materialIndex].enableTexture == 1) {
                mat3 uvs;
                uvs[0] = vec3(t.uv[0], 0);
                uvs[1] = vec3(t.uv[1], 0);
                uvs[2] = vec3(t.uv[2], 0);
                vec2 uv = InterpolateAttribute(hit, uvs).xy;
                uv.y = -uv.y;
                hitColor = texture(sampler2D(textures[nonuniformEXT(material.material[t.materialIndex].texture)], samplers[0]), uv).xyz;
            }
            // Apply normal texture
            if (material.material[t.materialIndex].normalMap != -1 && material.material[t.materialIndex].enableNormalMap == 1) {
                mat3 uvs;
                uvs[0] = vec3(t.uv[0], 0);
                uvs[1] = vec3(t.uv[1], 0);
                uvs[2] = vec3(t.uv[2], 0);
                vec2 uv = InterpolateAttribute(hit, uvs).xy;
                uv.y = -uv.y;
                vec3 hitNormal = texture(sampler2D(textures[nonuniformEXT(material.material[t.materialIndex].normalMap)], samplers[1]), uv).xyz;
                hitNormal = hitNormal * (255.0/127.0) - vec3(128.0/127.0);
                hitNormal.x = -hitNormal.x;
                mat3 normalTbn = TbnUv(hit.normal, t);
                hit.normal = normalTbn * hitNormal;
            }
            // Apply roughness texture
            if (material.material[t.materialIndex].roughnessMap != -1 && material.material[t.materialIndex].enableRoughnessMap == 1) {
                mat3 uvs;
                uvs[0] = vec3(t.uv[0], 0);
                uvs[1] = vec3(t.uv[1], 0);
                uvs[2] = vec3(t.uv[2], 0);
                vec2 uv = InterpolateAttribute(hit, uvs).xy;
                uv.y = -uv.y;
                roughness = texture(sampler2D(textures[nonuniformEXT(material.material[t.materialIndex].roughnessMap)], samplers[1]), uv).x;
            }

            // Apply Reflections
            vec3 incidentVector = r.direction;
            float cosTheta = dot(incidentVector, hit.normal);
            float rand2 = rand();
            float randTrans = rand();

            float fresnel = mix(material.material[t.materialIndex].metallic, 1, FresnelDielectric(cosTheta, material.material[t.materialIndex].ior));
            if (fresnel > rand()) {
                mat3 tbn = Tbn(cosTheta < 0 ? -hit.normal : hit.normal);
                vec3 tbnIncident = incidentVector * tbn;
                vec2 u;
                u.x = rand();
                u.y = rand();

                vec3 tbnNormal = sampleGgxVndf(tbnIncident, vec2(roughness, roughness), u);
                vec3 tbnReflected = Reflect(tbnIncident, tbnNormal);

                Ray reflectionRay;
                reflectionRay.direction = tbn * tbnReflected;
                reflectionRay.origin = hit.point + reflectionRay.direction * 0.001;
                r = reflectionRay;
                materialColor *= mix(vec3(1), hitColor, material.material[t.materialIndex].metallic);
            }
            else if (randTrans > material.material[t.materialIndex].transmissive) {
                color += materialColor * material.material[t.materialIndex].emissionColor * material.material[t.materialIndex].emissionIntensity;
                materialColor *= hitColor;

                // Apply sun shadows
                Ray shadowRay;
                shadowRay.direction = -pc.sun.dir;
                vec2 u = vec2(rand(), rand());
                vec2 randomPoint = UniformRandomCirclePoint(tan(pc.sun.angle/180*PI), u);
                mat3 tbn = Tbn(shadowRay.direction);
                shadowRay.direction = tbn * normalize(vec3(randomPoint.x, randomPoint.y, 1));
                shadowRay.origin = hit.point + (shadowRay.direction * 0.001);
                HitPoint shadowHit;
                Triangle tShadow;
                int tShadowId;
                shadowHit = BVHHit(shadowRay, tShadow, tShadowId);
                if (!shadowHit.hit || tShadowId == triangleId) {
                    float d = dot(pc.sun.dir, hit.normal) * pc.sun.intensity;
                    if (d < 0)
                        d = 0;
                    color += pc.sun.color * d * materialColor;
                }

                // Diffuse global illumination
                Ray diffuseRay;
                diffuseRay.direction = cosWeightedRandomHemisphereDirection(-hit.normal);
                diffuseRay.origin = hit.point + (diffuseRay.direction * 0.001);
                r = diffuseRay;
            }
            // Transmissive
            else {
                mat3 tbn = Tbn(cosTheta < 0 ? -hit.normal : hit.normal);
                vec3 tbnIncident = incidentVector * tbn;
                vec2 u;
                u.x = rand();
                u.y = rand();

                vec3 tbnNormal = sampleGgxVndf(tbnIncident, vec2(roughness, roughness), u);
                vec3 tbnRefracted = Refract(tbnIncident, cosTheta < 0 ? -tbnNormal : tbnNormal, material.material[t.materialIndex].ior);

                Ray transRay;
                transRay.direction = tbn * tbnRefracted;
                transRay.origin = hit.point + transRay.direction* 0.001;
                r = transRay;
                materialColor *= hitColor;
            }
        }
        else {
            if (-dot(r.direction, pc.sun.dir) > cos(pc.sun.angle / 180 * PI)) {
                color += pc.sun.color * pc.sun.intensity * materialColor;
            }
            color += pc.skyColor * materialColor;
            break;
        }
    }
    return color;
}

void main() {
    uvec2 pos = gl_GlobalInvocationID.xy;
    if (pos.x > pc.width || pos.y > pc.height) {
        return;
    }
    seed = vec3(pos.x, pos.y, pc.time);
    Ray r;
    r.origin = pc.cameraPos;

    vec2 rv2 = vec2(rand(), rand());

    r.direction.x = float(pos.x + rv2.x) / float(pc.width) - 0.5;
    r.direction.y = float(pos.y + rv2.y) / float(pc.height) - 0.5;
    r.direction.y *= -float(pc.height)/float(pc.width);
    r.direction.z = 0.5;
    r.direction = normalize(r.direction);
    r.direction = r.direction * pc.rotmat;

    Triangle t;

    vec3 color = Shade(r, pc.depth);

    float exposure = 1.5;
    color = 1 - exp(-color * exposure);

    o.a[pos.x + pos.y * pc.width] = color;
}